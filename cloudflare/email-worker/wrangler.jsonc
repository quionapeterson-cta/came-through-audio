{
  // Cloudflare Email Worker for the Admin Inbox (founder, 2026-11-17).
  //
  // Deploy from the repo root:  npx wrangler deploy -c cloudflare/email-worker/wrangler.jsonc
  // Then in the dashboard: Email → Email Routing → Email Workers, route admin@ and contracts@ to this Worker. No MX
  // record changes and every other address keeps the rule it already has.
  //
  // Two settings are deliberately not here, because each environment has its own value:
  //   INBOX_URL            var     the deployed receiver, e.g. https://<origin>/api/public/email/inbound
  //   INBOUND_EMAIL_SECRET secret  the same value the app holds, set with
  //                                npx wrangler secret put INBOUND_EMAIL_SECRET -c cloudflare/email-worker/wrangler.jsonc
  // Add both under Workers → came-through-audio-inbox → Settings. Until INBOX_URL is set the Worker refuses every
  // message, so a half-configured deploy delays mail instead of sending it somewhere wrong.
  //
  // The Gmail copy each department reads is a setting too, because the departments read different mailboxes:
  //   FORWARD_TO_REGISTRATIONS  var  regs.camethroughaudio.com@gmail.com
  //   FORWARD_TO_ADMIN          var  camethroughaudio.com@gmail.com
  //   FORWARD_TO_CONTRACTS      var  camethroughaudio.com@gmail.com
  //   FORWARD_TO_MARKETING      var  info.camethroughaudio.com@gmail.com
  //   FORWARD_TO_PARTNERS       var  info.camethroughaudio.com@gmail.com
  //   FORWARD_TO_INFO           var  info.camethroughaudio.com@gmail.com
  //   FORWARD_TO_COLLABORATE    var  info.camethroughaudio.com@gmail.com
  //   FORWARD_TO                var  the copy for any mailbox without its own value
  // A forward only reaches an address Cloudflare has verified under Email Routing → Destination addresses.
  "name": "came-through-audio-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "observability": { "enabled": true }
}
